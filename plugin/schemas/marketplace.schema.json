{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://wzrd.tech/schemas/agent-plugins-1.0.0/marketplace.json",
  "title": "Agent Plugins 1.0.0 — marketplace.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "owner", "plugins"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string" },
        "email": { "type": "string" }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "description", "version"],
        "properties": {
          "name": { "type": "string" },
          "source": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "author": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name"],
            "properties": { "name": { "type": "string" }, "url": { "type": "string" } }
          }
        }
      }
    }
  }
}
