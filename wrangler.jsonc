{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wzrd-studio",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ixkkrousepsiorwlaycp.supabase.co",
    "WZRDCLAW_ZONE_URL": "https://wzrdclaw20.vercel.app"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "env": {
    "landing": {
      "name": "wzrd-landing"
    }
  }
}
